PORT=5000
# "memory" = zero-config in-memory MongoDB, persisted to backend/.mongo-data/ (see config/db.js).
# Swap for a real connection string (local mongod, or MongoDB Atlas) when you're ready to deploy.
MONGO_URI=memory
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173
DEMAND_AUCTION_THRESHOLD=25
